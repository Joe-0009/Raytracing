# Simple MiniRT Test Scene
# Basic scene for quick testing

# Ambient lighting
A 0.1 255,255,255

# Camera
C 0,0,-10 0,0,1 70

# Main light - white
L -5,5,-5 0.7 255,255,255

# Light on the right - blue tint
L 5,3,-3 0.5 200,220,255

# Central red sphere
sp 0,0,0 2 255,100,100

# Green sphere on the left
sp -4,0,2 1.5 100,255,100

# Blue sphere on the right
sp 4,0,2 1.5 100,100,255

# Ground plane
pl 0,-3,0 0,1,0 200,200,200

# Simple cone
cn -2,-3,3 0,1,0 50 4 255,200,100

# Small cylinder
cy 2,-1,1 0,1,0 0.5 3 150,255,150
