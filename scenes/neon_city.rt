# Neon City Scene - Cyberpunk cityscape with glowing elements
# Dark atmosphere with bright neon colors

A 0.1 50,50,80

C 0,8,25 0,-0.3,-1 80

L 5,15,20 0.4 255,0,255
L -8,12,18 0.3 0,255,255
L 10,10,15 0.5 255,255,0

# Dark ground - asphalt
pl 0,0,0 0,1,0 30,30,30

# Building foundations - dark cylinders
cy -10,0,5 0,1,0 3 12 40,40,40
cy 8,0,8 0,1,0 2.8 15 35,35,35
cy -5,0,15 0,1,0 2.5 10 45,45,45
cy 12,0,-2 0,1,0 3.2 18 38,38,38

# Neon signs - bright spheres at building tops
sp -10,12,5 1.2 255,0,255
sp 8,15,8 1 0,255,255
sp -5,10,15 0.8 255,255,0
sp 12,18,-2 1.5 255,100,0

# Neon tube lights - horizontal cylinders
cy -12,8,5 1,0,0 0.2 4 255,0,255
cy 6,12,8 1,0,0 0.15 3 0,255,255
cy -7,7,15 1,0,0 0.25 2.5 255,255,0

# Street lights - vertical thin cylinders with spheres
cy 0,0,10 0,1,0 0.3 8 100,100,100
sp 0,8,10 0.8 255,255,255
cy -15,0,0 0,1,0 0.3 7 100,100,100
sp -15,7,0 0.7 255,255,200

# Flying vehicles - small spheres
sp 3,12,12 0.6 255,50,50
sp -8,15,20 0.5 50,255,50
sp 15,10,5 0.7 50,50,255
