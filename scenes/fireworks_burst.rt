# Fireworks Burst Scene - Celebration with multiple explosions
# Colorful particle effects in night sky

A 0.05 20,20,40

C 0,5,25 0,0,-1 85

L 0,20,20 0.3 255,255,255

# Dark night sky
pl 0,50,0 0,-1,0 10,10,30

# Main firework burst - center high
sp 0,15,0 1.0 255,255,255

# Primary burst pattern - 8 directions
sp 3,15,0 0.8 255,0,0
sp -3,15,0 0.8 0,255,0
sp 0,18,0 0.8 0,0,255
sp 0,12,0 0.8 255,255,0
sp 2.1,17.1,0 0.7 255,0,255
sp -2.1,17.1,0 0.7 0,255,255
sp 2.1,12.9,0 0.7 255,128,0
sp -2.1,12.9,0 0.7 128,255,0

# Secondary sparks - smaller and dimmer
sp 4.5,15,0 0.4 200,50,50
sp -4.5,15,0 0.4 50,200,50
sp 0,19.5,0 0.4 50,50,200
sp 0,10.5,0 0.4 200,200,50

# Left side firework
sp -12,12,5 0.8 255,100,255
sp -15,12,5 0.6 255,150,255
sp -9,12,5 0.6 200,50,200
sp -12,15,5 0.5 255,200,255
sp -12,9,5 0.5 150,0,150

# Right side firework
sp 15,18,-3 0.9 100,255,100
sp 18,18,-3 0.6 150,255,150
sp 12,18,-3 0.6 50,200,50
sp 15,21,-3 0.5 200,255,200
sp 15,15,-3 0.5 0,150,0

# Falling sparks
sp 1,8,2 0.3 255,200,0
sp -2,7,1 0.25 255,150,0
sp 3,6,-1 0.3 255,100,0
sp -1,5,3 0.2 200,100,0
