# Galaxy Spiral Scene - Spiral arm formation with colored stars
# Creates a spiral pattern with decreasing sphere sizes toward the center

A 0.1 30,30,60

C 0,0,25 0,0,-1 80

L 0,0,20 0.3 200,200,255
L 10,10,15 0.2 255,200,150

# Central supermassive "black hole" - dark purple
sp 0,0,0 2 50,0,50

# Inner spiral arm - bright stars
sp 3,0,0 0.8 255,255,255
sp 2.1,2.1,0 0.7 255,200,100
sp 0,3,0 0.6 100,200,255
sp -2.1,2.1,0 0.8 255,100,100
sp -3,0,0 0.7 200,255,200
sp -2.1,-2.1,0 0.6 255,255,100
sp 0,-3,0 0.8 100,100,255
sp 2.1,-2.1,0 0.7 255,150,255

# Outer spiral arm - medium stars
sp 6,0,0 1.2 255,200,150
sp 4.2,4.2,0 1.0 200,150,255
sp 0,6,0 0.9 150,255,150
sp -4.2,4.2,0 1.1 255,150,100
sp -6,0,0 1.0 150,200,255
sp -4.2,-4.2,0 0.9 255,255,150
sp 0,-6,0 1.2 200,100,255
sp 4.2,-4.2,0 1.0 255,200,200

# Far spiral arm - distant stars
sp 9,0,0 1.5 200,200,255
sp 6.4,6.4,0 1.3 255,180,120
sp 0,9,0 1.2 180,255,180
sp -6.4,6.4,0 1.4 255,120,150
sp -9,0,0 1.3 180,180,255
sp -6.4,-6.4,0 1.2 255,255,180
sp 0,-9,0 1.5 180,150,255
sp 6.4,-6.4,0 1.3 255,180,180
