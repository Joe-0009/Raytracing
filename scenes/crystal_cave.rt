# Crystal Cave Scene - Geometric crystal formations
# Creates a cave-like environment with crystal structures

A 0.15 150,150,200

C 0,3,12 0,0,-1 85

L 2,8,8 0.6 200,200,255
L -3,5,6 0.4 255,200,255
L 0,6,4 0.3 200,255,255

# Cave floor - dark rock
pl 0,0,0 0,1,0 80,70,60

# Cave ceiling - rough texture
pl 0,8,0 0,-1,0 90,80,70

# Cave walls
pl -6,0,0 1,0,0 70,60,50
pl 6,0,0 -1,0,0 70,60,50
pl 0,0,-2 0,0,1 75,65,55

# Large central crystal cluster - purple/blue
cy 0,1,2 0,1,0.3 1.5 4 150,100,255
cy 1,0.5,1.5 0.2,1,0.1 1.2 3.5 180,120,255
cy -0.8,0.8,2.2 -0.1,1,0.2 1.0 3 120,150,255

# Crystal tops - pointed
cn 0,5,2.5 0,-1,-0.3 45 2 200,150,255
cn 1,4,1.8 -0.2,-1,-0.1 40 1.8 220,170,255
cn -0.8,3.8,2.6 0.1,-1,-0.2 35 1.5 170,200,255

# Side crystal formations
cy 3,0.5,0 0.3,1,0 0.8 2.5 100,255,200
cn 3,3,0.2 -0.3,-1,0 30 1.2 150,255,220

cy -3.5,0.3,1 -0.2,1,0.1 0.9 2.8 255,200,150
cn -3.5,3.1,1.2 0.2,-1,-0.1 35 1.4 255,220,180

# Small crystal shards scattered
sp 2,0.5,3 0.4 200,200,255
sp -1.5,0.3,3.5 0.3 255,200,200
sp 1.8,0.2,0.5 0.35 200,255,200
sp -2.2,0.4,2.8 0.4 255,255,200
