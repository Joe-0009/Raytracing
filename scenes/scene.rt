# Complex MiniRT Test Scene - Multiple Lights and Objects
# This scene showcases performance differences between standard MLX and MLX42

# Ambient lighting
A 0.2 255,255,255

# Camera positioned to view the scene
C 0,3,-15 0,0,1 70

# Multiple lights with different colors
L 5,10,-5 0.8 255,200,150
L -5,8,3 0.6 150,200,255
L 0,12,0 0.5 255,150,200
L 8,5,-8 0.7 200,255,150

# Central sphere - red metallic
sp 0,0,0 4 255,100,100

# Left sphere - blue
sp -8,0,2 3 100,150,255

# Right sphere - green
sp 8,0,-2 3 150,255,100

# Back sphere - purple
sp 0,0,8 2.5 200,100,255

# Top sphere - yellow
sp 0,6,0 2 255,255,100

# Ground plane - gray
pl 0,-4,0 0,1,0 180,180,180

# Back wall - dark blue
pl 0,0,15 0,0,-1 50,50,100

# Left wall - dark red
pl -15,0,0 1,0,0 100,50,50

# Right wall - dark green
pl 15,0,0 -1,0,0 50,100,50

# Cylinders around the scene
cy -6,-2,-6 0,1,0 2 8 255,150,100
cy 6,-2,6 0,1,0 2 8 100,255,150

# Cones - pointing upward
cn -4,-4,4 0,1,0 50 6 255,200,50
cn 4,-4,-4 0,1,0 40 6 50,255,200

# More cnnes at different angles
cn 0,-4,6 0.3,1,0.3 30 5 255,100,255
cn -6,-4,0 1,1,0 50 7 100,255,255

# Additional spheres for complexity
sp 3,2,3 1.5 255,255,255
sp -3,2,-3 1.5 200,200,200
sp 5,-1,5 1 255,180,100
sp -5,-1,-5 1 100,180,255

# Floating cylinders
cy 0,8,5 1,0,0 1 4 255,150,255
cy 0,8,-5 1,0,0 1 4 150,255,255

# Small decorative spheres
sp 2,4,2 0.8 255,255,0
sp -2,4,-2 0.8 0,255,255
sp 4,1,-6 0.6 255,0,255
sp -4,1,6 0.6 255,128,0
